# Copy this file to .env.production (or set as a build-time environment variable in your
# hosting provider, e.g. Render's dashboard -> your frontend service -> Environment) before
# building for a deployment where the frontend and backend are on different domains.
#
# Leave this UNSET for local development — Vite's dev-server proxy (see vite.config.js)
# handles /api -> http://localhost:8080 automatically.

VITE_API_BASE_URL=https://calculon-backend.onrender.com/api
